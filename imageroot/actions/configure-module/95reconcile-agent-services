#!/usr/bin/env python3

import json
import os
import subprocess
import sys
from pathlib import Path

import agent

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "pypkg"))

from action_logging import log_action_failure
from hermes_agent_state import (
    BASE_VIRTUALHOST_PREVIOUS_ENV,
    LETS_ENCRYPT_PREVIOUS_ENV,
    agent_runtime_fingerprint,
    auth_runtime_fingerprint,
    read_agents_from_state,
    read_runtime_fingerprints,
    write_runtime_fingerprints,
)
from hermes_user_domain import auth_required


def run(command, check=True):
    return subprocess.run(command, check=check)


def is_active(unit_name):
    return run(["systemctl", "--user", "is-active", "--quiet", unit_name], check=False).returncode == 0


def note(message):
    print(f"configure-module/95reconcile-agent-services: {message}", file=sys.stderr)


def stop_disable_agent(agent_id):
    # Reset the whole runtime footprint for stopped agents so systemd can
    # recreate the declared one-agent/one-pod layout on the next start.
    run(["systemctl", "--user", "disable", "--now", f"hermes-socket@{agent_id}.service"], check=False)
    run(["systemctl", "--user", "disable", "--now", f"hermes@{agent_id}.service"], check=False)
    run(["systemctl", "--user", "stop", f"hermes-pod@{agent_id}.service"], check=False)
    run(["podman", "pod", "rm", "--force", f"hermes-pod-{agent_id}"], check=False)
    run(["podman", "rm", "--force", f"hermes-{agent_id}"], check=False)
    run(["podman", "rm", "--force", f"hermes-socket-{agent_id}"], check=False)


def restart_agent(agent_id):
    # Stop first so the unit rebuilds the pod and containers from the fresh
    # generated env files instead of reusing stale runtime state.
    run(["systemctl", "--user", "stop", f"hermes-socket@{agent_id}.service"], check=False)
    run(["systemctl", "--user", "stop", f"hermes@{agent_id}.service"], check=False)
    run(["systemctl", "--user", "stop", f"hermes-pod@{agent_id}.service"], check=False)
    run(["systemctl", "--user", "start", f"hermes@{agent_id}.service"])
    run(["systemctl", "--user", "start", f"hermes-socket@{agent_id}.service"])


def reconcile_agent(agent_data, previous_fingerprints, next_fingerprints):
    agent_id = agent_data["id"]
    if agent_data["status"] != "start":
        stop_disable_agent(agent_id)
        return

    run(["systemctl", "--user", "enable", f"hermes@{agent_id}.service"])
    run(["systemctl", "--user", "enable", f"hermes-socket@{agent_id}.service"])

    fingerprint = agent_runtime_fingerprint(agent_id)
    next_fingerprints[str(agent_id)] = fingerprint

    # Only bounce agents whose generated inputs changed or that are not
    # actually running; every restart drops the gateway's live sessions.
    unchanged = previous_fingerprints.get(str(agent_id)) == fingerprint
    if unchanged and is_active(f"hermes@{agent_id}.service") and is_active(f"hermes-socket@{agent_id}.service"):
        note(f"agent {agent_id} runtime inputs unchanged, leaving services running")
        return

    restart_agent(agent_id)


def reconcile_auth(required, previous_fingerprint):
    if not required:
        run(["systemctl", "--user", "disable", "--now", "hermes-auth.service"], check=False)
        run(["podman", "rm", "--force", "hermes-auth"], check=False)
        return ""

    run(["systemctl", "--user", "enable", "hermes-auth.service"])
    fingerprint = auth_runtime_fingerprint()
    if previous_fingerprint == fingerprint and is_active("hermes-auth.service"):
        note("auth proxy inputs unchanged, leaving hermes-auth.service running")
        return fingerprint

    run(["systemctl", "--user", "stop", "hermes-auth.service"], check=False)
    run(["systemctl", "--user", "start", "hermes-auth.service"])
    return fingerprint


def main():
    json.load(sys.stdin)
    desired_agents = read_agents_from_state()
    previous = read_runtime_fingerprints()
    next_fingerprints = {"agents": {}, "auth": ""}

    for agent_data in desired_agents:
        reconcile_agent(agent_data, previous["agents"], next_fingerprints["agents"])

    required = auth_required((os.getenv("BASE_VIRTUALHOST") or "").strip().lower(), desired_agents)
    next_fingerprints["auth"] = reconcile_auth(required, previous["auth"])

    write_runtime_fingerprints(next_fingerprints)

    agent.unset_env(BASE_VIRTUALHOST_PREVIOUS_ENV)
    agent.unset_env(LETS_ENCRYPT_PREVIOUS_ENV)


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        log_action_failure("configure-module/95reconcile-agent-services", error)
        raise
