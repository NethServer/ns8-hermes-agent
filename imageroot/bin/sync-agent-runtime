#!/usr/bin/env python3

import argparse
import os
import secrets
import sys
from pathlib import Path

import agent

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "pypkg"))

from hermes_agent_state import (
    AGENT_SECRET_KEY,
    AGENT_ALLOWED_USER_ENV,
    AGENTS_DIR,
    AGENT_PUBLIC_ENVFILE,
    API_SERVER_SECRET_KEY,
    AUTH_SESSION_SECRET_KEY,
    AUTHPROXY_AGENTS_FILE,
    AUTHPROXY_ENVFILE,
    LEGACY_AUTHPROXY_AGENTS_FILE,
    AUTHPROXY_SECRETS_ENVFILE,
    BASE_VIRTUALHOST_ENV,
    SECRETS_DIR,
    SHARED_SECRETS_ENVFILE,
    SMTP_PUBLIC_KEYS,
    SMTP_SECRET_KEY,
    USER_DOMAIN_ENV,
    agent_dashboard_socket_path,
    ensure_private_directory,
    read_agent_state_report,
    write_jsonfile,
)
from hermes_user_domain import public_runtime_env, secrets_runtime_env


def timezone_value(shared_environment=None):
    if shared_environment is None:
        shared_environment = os.environ

    value = (shared_environment.get("TIMEZONE") or "UTC").strip()
    return value or "UTC"


def generate_secret():
    return secrets.token_hex(16)


def read_optional_envfile(path):
    if not os.path.exists(path):
        return {}

    return agent.read_envfile(path)


def read_valid_agents():
    # A corrupt sibling must not stop this agent's unit from starting; report
    # the broken directories on stderr and carry on with the healthy set.
    report = read_agent_state_report()
    for entry in report["invalid"]:
        print(f"sync-agent-runtime: ignoring agents/{entry['directory']}: {entry['error']}", file=sys.stderr)
    return report["agents"]


def agent_by_id(agent_id, agent_data_list=None):
    if agent_data_list is None:
        agent_data_list = read_valid_agents()
    for agent_data in agent_data_list:
        if agent_data["id"] == agent_id:
            return agent_data

    raise ValueError(f"agent {agent_id} not found")


def existing_agent_api_server_keys(agent_data_list):
    api_server_keys = {}

    for agent_data in agent_data_list:
        agent_secrets_path = SECRETS_DIR / Path(f"{agent_data['id']}.env")
        api_server_key = (read_optional_envfile(agent_secrets_path).get(API_SERVER_SECRET_KEY) or "").strip()
        if api_server_key:
            api_server_keys[agent_data["id"]] = api_server_key

    return api_server_keys


def build_agent_public_env(agent_data, shared_environment):
    # Containers only consume generated per-agent env files, so copy the shared
    # public settings they need and overlay agent-specific fields here.
    env_data = {
        "AGENT_ID": str(agent_data["id"]),
        "AGENT_NAME": agent_data["name"],
        "AGENT_ROLE": agent_data["role"],
        "TIMEZONE": timezone_value(shared_environment),
        "TZ": timezone_value(shared_environment),
    }

    base_virtualhost = (shared_environment.get(BASE_VIRTUALHOST_ENV) or "").strip().lower()
    if base_virtualhost:
        env_data[BASE_VIRTUALHOST_ENV] = base_virtualhost

    allowed_user = (agent_data.get("allowed_user") or "").strip()
    if allowed_user:
        env_data[AGENT_ALLOWED_USER_ENV] = allowed_user

    # Only the shared auth proxy talks to LDAP. Agents get the domain name for
    # display purposes and nothing that would let them reach the directory.
    user_domain = (shared_environment.get(USER_DOMAIN_ENV) or "").strip().lower()
    if user_domain:
        env_data[USER_DOMAIN_ENV] = user_domain

    for key in SMTP_PUBLIC_KEYS:
        value = shared_environment.get(key)
        if value:
            env_data[key] = value

    return env_data


def build_agent_secrets(
    existing_agent_secrets,
    shared_secrets,
    shared_environment,
    reserved_api_server_keys=None,
):
    # Preserve each agent secret across regenerations while still projecting the
    # current module-wide SMTP password into the private file. LDAP bind
    # credentials are deliberately never handed to agent containers.
    if reserved_api_server_keys is None:
        reserved_api_server_keys = set()

    api_server_key = (existing_agent_secrets.get(API_SERVER_SECRET_KEY) or "").strip()
    if not api_server_key or api_server_key in reserved_api_server_keys:
        while True:
            api_server_key = generate_secret()
            if api_server_key not in reserved_api_server_keys:
                break

    env_data = {
        AGENT_SECRET_KEY: existing_agent_secrets.get(AGENT_SECRET_KEY) or generate_secret(),
        API_SERVER_SECRET_KEY: api_server_key,
    }

    smtp_password = shared_secrets.get(SMTP_SECRET_KEY)
    if smtp_password:
        env_data[SMTP_SECRET_KEY] = smtp_password

    return env_data


def ensure_shared_session_secret(shared_secrets):
    session_secret = (shared_secrets.get(AUTH_SESSION_SECRET_KEY) or "").strip()
    if session_secret:
        return shared_secrets

    updated_shared_secrets = dict(shared_secrets)
    updated_shared_secrets[AUTH_SESSION_SECRET_KEY] = generate_secret()
    ensure_private_directory(SECRETS_DIR)
    agent.write_envfile(SHARED_SECRETS_ENVFILE, updated_shared_secrets)
    return updated_shared_secrets


def build_authproxy_env(shared_environment):
    env_data = {
        "TIMEZONE": timezone_value(shared_environment),
        "TZ": timezone_value(shared_environment),
    }

    user_domain = (shared_environment.get(USER_DOMAIN_ENV) or "").strip().lower()
    if user_domain:
        env_data.update(public_runtime_env(user_domain))

    return env_data


def build_authproxy_secrets(shared_secrets, shared_environment):
    env_data = {
        AUTH_SESSION_SECRET_KEY: shared_secrets[AUTH_SESSION_SECRET_KEY],
    }

    user_domain = (shared_environment.get(USER_DOMAIN_ENV) or "").strip().lower()
    if user_domain:
        env_data.update(secrets_runtime_env(user_domain))

    return env_data


def build_authproxy_agents(agent_data_list):
    agent_records = []

    for agent_data in agent_data_list:
        allowed_user = (agent_data.get("allowed_user") or "").strip()
        if not allowed_user:
            continue

        agent_records.append(
            {
                "id": agent_data["id"],
                "name": agent_data["name"],
                "allowed_user": allowed_user,
                "status": agent_data["status"],
                "upstream_socket": agent_dashboard_socket_path(agent_data["id"]),
            }
        )

    return {"agents": agent_records}


def sync_agent_runtime_files(agent_id=None):
    shared_environment = agent.read_envfile("environment")
    shared_secrets = ensure_shared_session_secret(agent.read_envfile(SHARED_SECRETS_ENVFILE))
    all_agent_data = read_valid_agents()
    agent_data_list = [agent_by_id(agent_id, all_agent_data)] if agent_id is not None else all_agent_data
    known_api_server_keys = existing_agent_api_server_keys(all_agent_data)

    agent.write_envfile(AUTHPROXY_ENVFILE, build_authproxy_env(shared_environment))
    agent.write_envfile(AUTHPROXY_SECRETS_ENVFILE, build_authproxy_secrets(shared_secrets, shared_environment))
    write_jsonfile(AUTHPROXY_AGENTS_FILE, build_authproxy_agents(all_agent_data))
    if LEGACY_AUTHPROXY_AGENTS_FILE.is_file():
        LEGACY_AUTHPROXY_AGENTS_FILE.unlink()

    ensure_private_directory(SECRETS_DIR)
    for agent_data in agent_data_list:
        agent_dir = AGENTS_DIR / str(agent_data["id"])
        ensure_private_directory(agent_dir)
        # Regenerate both files from the canonical shared state so systemd unit
        # restarts always see a complete, current runtime snapshot.
        agent.write_envfile(
            agent_dir / AGENT_PUBLIC_ENVFILE,
            build_agent_public_env(agent_data, shared_environment),
        )
        agent_secrets_path = SECRETS_DIR / Path(f"{agent_data['id']}.env")
        existing_agent_secrets = read_optional_envfile(agent_secrets_path)
        agent_secrets = build_agent_secrets(
            existing_agent_secrets,
            shared_secrets,
            shared_environment,
            {
                api_server_key
                for existing_agent_id, api_server_key in known_api_server_keys.items()
                if existing_agent_id != agent_data["id"]
            },
        )
        known_api_server_keys[agent_data["id"]] = agent_secrets[API_SERVER_SECRET_KEY]
        agent.write_envfile(
            agent_secrets_path,
            agent_secrets,
        )


def main():
    parser = argparse.ArgumentParser(description="Generate per-agent runtime env files")
    parser.add_argument("--agent-id", type=int, help="Sync only one agent")
    args = parser.parse_args()

    try:
        sync_agent_runtime_files(agent_id=args.agent_id)
    except ValueError as error:
        print(str(error), file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())