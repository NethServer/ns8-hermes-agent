#!/usr/bin/env python3
# Migrate flat per-agent secrets files from the state root to state/secrets/.
# Idempotent: files already in their new location are left untouched, and a
# legacy shared file is merged key by key into the new one instead of being
# discarded, because older discover-smarthost releases kept refreshing the
# legacy path after the shared file had already been created.
#
#   secrets.env           → secrets/shared.env (merged)
#   agent_{N}_secrets.env → secrets/{N}.env

import re
import shutil
import sys
from pathlib import Path

import agent

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "pypkg"))

from hermes_agent_state import SECRETS_DIR, SHARED_SECRETS_ENVFILE, ensure_private_directory

LEGACY_SHARED_SECRETS_ENVFILE = Path("secrets.env")
OLD_AGENT_SECRETS_PATTERN = re.compile(r"^agent_(\d+)_secrets\.env$")


def migrate_file(src, dst):
    if not src.exists():
        return
    if dst.exists():
        print(f"Already migrated, removing old: {src}", flush=True)
        src.unlink()
        return
    print(f"Migrating {src} → {dst}", flush=True)
    shutil.move(str(src), str(dst))


def merge_shared_secrets(src, dst):
    if not src.exists():
        return

    if not dst.exists():
        print(f"Migrating {src} → {dst}", flush=True)
        shutil.move(str(src), str(dst))
        return

    # The legacy file is the most recently refreshed copy of the smarthost
    # password, so its keys win over stale values in the destination.
    merged_secrets = agent.read_envfile(str(dst))
    merged_secrets.update(agent.read_envfile(str(src)))
    print(f"Merging {src} → {dst}", flush=True)
    agent.write_envfile(str(dst), merged_secrets)
    src.unlink()


ensure_private_directory(SECRETS_DIR)

merge_shared_secrets(LEGACY_SHARED_SECRETS_ENVFILE, SHARED_SECRETS_ENVFILE)

for path in sorted(Path(".").iterdir()):
    match = OLD_AGENT_SECRETS_PATTERN.fullmatch(path.name)
    if match:
        agent_id = match.group(1)
        migrate_file(path, SECRETS_DIR / f"{agent_id}.env")
